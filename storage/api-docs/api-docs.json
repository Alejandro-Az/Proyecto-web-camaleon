{
    "openapi": "3.0.0",
    "info": {
        "title": "Camaleón API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor base de la API"
        }
    ],
    "paths": {
        "/admin/eventos/{event}/regalos/{gift}/marcar-comprado": {
            "post": {
                "tags": [
                    "Admin Regalos"
                ],
                "summary": "Marca un regalo como comprado",
                "description": "Marca el regalo como comprado, actualiza claims reservados y recalcula cantidades reservadas.",
                "operationId": "c408a62f2634769d66b1b4bd749605a1",
                "parameters": [
                    {
                        "name": "event",
                        "in": "path",
                        "description": "ID del evento",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "gift",
                        "in": "path",
                        "description": "ID del regalo",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Regalo marcado como comprado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Regalo marcado como comprado."
                                        },
                                        "gift_id": {
                                            "type": "integer",
                                            "example": 10
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "purchased"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permisos"
                    },
                    "404": {
                        "description": "Evento o regalo no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/events/{event}/photos": {
            "post": {
                "tags": [
                    "Admin - Fotos"
                ],
                "summary": "Sube una foto para un evento (galería, portada o dress_code)",
                "operationId": "382b9f91a0a195e7f93e91c9a921e90b",
                "parameters": [
                    {
                        "name": "event",
                        "in": "path",
                        "description": "ID del evento",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "photo"
                                ],
                                "properties": {
                                    "photo": {
                                        "description": "Archivo de imagen a subir",
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "type": {
                                        "description": "Tipo de foto",
                                        "type": "string",
                                        "enum": [
                                            "gallery",
                                            "hero",
                                            "dress_code"
                                        ]
                                    },
                                    "caption": {
                                        "description": "Texto opcional de la foto",
                                        "type": "string",
                                        "maxLength": 255,
                                        "nullable": true
                                    },
                                    "display_order": {
                                        "description": "Orden de despliegue (si no se envía, se asigna automático)",
                                        "type": "integer",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Foto subida correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "event_id": {
                                            "type": "integer"
                                        },
                                        "type": {
                                            "type": "string"
                                        },
                                        "caption": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "display_order": {
                                            "type": "integer"
                                        },
                                        "file_url": {
                                            "type": "string"
                                        },
                                        "thumbnail_url": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permisos (rol incorrecto)"
                    },
                    "422": {
                        "description": "Errores de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Inicia sesión y retorna token JWT",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin.demo@camaleon.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token emitido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "bearer"
                                        },
                                        "expires_in": {
                                            "type": "integer",
                                            "example": 3600
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    },
                    "422": {
                        "description": "Errores de validación"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Retorna el usuario autenticado",
                "operationId": "b5de204f5e452ef51327c691aa99e77c",
                "responses": {
                    "200": {
                        "description": "Usuario actual",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "role": {
                                            "type": "string",
                                            "example": "admin"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Invalida el token actual",
                "operationId": "df9bdc6c7a6d9f20b983526b2ec0f698",
                "responses": {
                    "200": {
                        "description": "Logout OK"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresca el token JWT",
                "operationId": "30c20c52f5f72828d8c531fd7c9ea3e7",
                "responses": {
                    "200": {
                        "description": "Token refrescado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "bearer"
                                        },
                                        "expires_in": {
                                            "type": "integer",
                                            "example": 3600
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/eventos/{slug}": {
            "get": {
                "tags": [
                    "Eventos Públicos"
                ],
                "summary": "Ver la página pública de un evento",
                "description": "Devuelve la página HTML pública de un evento identificado por su slug. La página puede incluir módulos como portada (hero), galería de fotos, itinerario del evento, RSVP, lista pública de asistentes, sugerencia de canciones y votos, así como fotos subidas por invitados, dependiendo de la configuración del evento.",
                "operationId": "publicShowEvent",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento (por ejemplo, boda-prueba-ana-luis)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Página HTML con la información pública del evento y sus módulos activos."
                    },
                    "404": {
                        "description": "Evento no encontrado o no visible públicamente."
                    }
                }
            }
        },
        "/eventos/{slug}/regalos/{gift}/liberar": {
            "post": {
                "tags": [
                    "Regalos Públicos"
                ],
                "summary": "Liberar (cancelar) la reserva de un regalo",
                "description": "Permite que un invitado libere la reserva de un regalo que previamente había apartado.",
                "operationId": "publicUnreserveGift",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "boda-prueba-ana-luis"
                        }
                    },
                    {
                        "name": "gift",
                        "in": "path",
                        "description": "ID del regalo dentro del evento",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "invitation_code"
                                ],
                                "properties": {
                                    "invitation_code": {
                                        "description": "Código de invitación del invitado que quiere liberar el regalo",
                                        "type": "string",
                                        "example": "DEMO1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reserva liberada correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "gift_id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "quantity_reserved": {
                                            "type": "integer",
                                            "example": 0
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "pending"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Evento no público, módulo de regalos desactivado o liberación deshabilitada."
                    },
                    "422": {
                        "description": "Errores de validación o reglas de negocio (invitación inválida, regalo no reservado, ya comprado, etc.)"
                    }
                }
            }
        },
        "/eventos/{slug}/fotos-invitados": {
            "post": {
                "tags": [
                    "Eventos Públicos"
                ],
                "summary": "Subir una foto al evento por parte de un invitado",
                "description": "Permite que un invitado suba una foto asociada a un evento usando su código de invitación. Respeta el límite de fotos por invitado y la configuración de aprobación automática.",
                "operationId": "publicUploadGuestPhoto",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento (por ejemplo, boda-prueba-ana-luis)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "invitation_code",
                                    "photo"
                                ],
                                "properties": {
                                    "invitation_code": {
                                        "description": "Código de invitación del invitado",
                                        "type": "string"
                                    },
                                    "caption": {
                                        "description": "Descripción breve de la foto (opcional)",
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "photo": {
                                        "description": "Archivo de imagen a subir",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Foto registrada correctamente."
                    },
                    "422": {
                        "description": "Error de validación, invitación inválida o límite de fotos excedido."
                    },
                    "404": {
                        "description": "Evento no encontrado o módulo desactivado."
                    }
                }
            }
        },
        "/eventos/{slug}/rsvp": {
            "post": {
                "tags": [
                    "RSVP"
                ],
                "summary": "Registrar/actualizar la confirmación de asistencia de un invitado",
                "description": "Actualiza el RSVP de un invitado identificado por su código de invitación para un evento público.",
                "operationId": "eceabbe93d3fa6585eb75313095723a1",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento (por ejemplo, boda-prueba-ana-luis)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "invitation_code",
                                    "rsvp_status"
                                ],
                                "properties": {
                                    "invitation_code": {
                                        "type": "string",
                                        "example": "DEMO1234"
                                    },
                                    "rsvp_status": {
                                        "type": "string",
                                        "enum": [
                                            "yes",
                                            "no",
                                            "maybe"
                                        ],
                                        "example": "yes"
                                    },
                                    "guests_confirmed": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "rsvp_message": {
                                        "type": "string",
                                        "example": "¡Nos vemos ahí!"
                                    },
                                    "show_in_public_list": {
                                        "type": "boolean",
                                        "example": true
                                    },
                                    "dietary_tags": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "dietary_notes": {
                                        "type": "string",
                                        "example": "Alergia fuerte al cacahuate"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redirección de vuelta a la página del evento con mensaje de éxito o error"
                    },
                    "404": {
                        "description": "Evento no encontrado, no visible públicamente o módulo de RSVP desactivado."
                    }
                }
            }
        },
        "/eventos/{slug}/canciones": {
            "post": {
                "tags": [
                    "Eventos Públicos"
                ],
                "summary": "Sugerir una canción para el evento",
                "description": "Registra una nueva canción sugerida para la playlist del evento. \n     *                  Soporta respuestas HTML (redirect) y JSON (AJAX) según el encabezado Accept.",
                "operationId": "publicSuggestSong",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento (por ejemplo, boda-prueba-ana-luis)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "invitation_code",
                                    "title"
                                ],
                                "properties": {
                                    "invitation_code": {
                                        "type": "string",
                                        "example": "DEMO1234"
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Perfect"
                                    },
                                    "artist": {
                                        "type": "string",
                                        "example": "Ed Sheeran"
                                    },
                                    "url": {
                                        "type": "string",
                                        "example": "https://open.spotify.com/track/..."
                                    },
                                    "message_for_couple": {
                                        "type": "string",
                                        "example": "Para el primer baile"
                                    },
                                    "show_author": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Canción sugerida correctamente (respuesta JSON cuando se usa AJAX)."
                    },
                    "302": {
                        "description": "Redirección a la página del evento con mensaje flash de éxito o error (uso tradicional de formulario HTML)."
                    },
                    "422": {
                        "description": "Error de validación, invitación no encontrada, límite alcanzado o canción duplicada."
                    },
                    "404": {
                        "description": "Evento no encontrado, no visible públicamente o módulo de canciones desactivado."
                    }
                }
            }
        },
        "/eventos/{slug}/canciones/{song}/votar": {
            "post": {
                "tags": [
                    "Eventos Públicos"
                ],
                "summary": "Votar o quitar voto a una canción del evento",
                "description": "Alterna el voto del invitado actual sobre una canción específica del evento. \n     *                  Soporta HTML (redirect) y JSON (AJAX).",
                "operationId": "publicVoteSong",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug del evento",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "song",
                        "in": "path",
                        "description": "ID de la canción del evento",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "invitation_code"
                                ],
                                "properties": {
                                    "invitation_code": {
                                        "type": "string",
                                        "example": "DEMO1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Voto registrado o retirado correctamente (JSON)."
                    },
                    "302": {
                        "description": "Redirección a la página del evento con mensaje flash."
                    },
                    "422": {
                        "description": "Invitación no encontrada o límite de votos alcanzado."
                    },
                    "404": {
                        "description": "Evento o canción no encontrados, o módulo de canciones desactivado."
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Use: Authorization: Bearer {token}",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Autenticación JWT"
        },
        {
            "name": "Eventos Públicos",
            "description": "Endpoints públicos relacionados con la visualización de eventos."
        },
        {
            "name": "RSVP",
            "description": "Endpoints para la confirmación de asistencia de invitados (RSVP)."
        },
        {
            "name": "Admin Regalos",
            "description": "Admin Regalos"
        },
        {
            "name": "Admin - Fotos",
            "description": "Admin - Fotos"
        },
        {
            "name": "Regalos Públicos",
            "description": "Regalos Públicos"
        }
    ]
}